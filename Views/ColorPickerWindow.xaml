<Window x:Class="ColorKids.Views.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choisir une couleur"
        Width="340" Height="540"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FF1E1E2E"
        Foreground="White">

    <Window.Resources>
        <Style x:Key="FlatSlider" TargetType="Slider">
            <Setter Property="Height" Value="20"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="10" CornerRadius="5"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="#44FFFFFF" BorderThickness="1"/>
                            <Track x:Name="PART_Track" Panel.ZIndex="1">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="18" Height="18"
                                                         Fill="White"
                                                         Stroke="#FF444444" StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
</Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="220"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="44"/>
        </Grid.RowDefinitions>

        <!-- Spectre SV -->
        <Grid Grid.Row="0">
            <Border x:Name="SvCanvas" CornerRadius="6" ClipToBounds="True" Cursor="Cross"
                    MouseDown="OnSvMouseDown" MouseMove="OnSvMouseMove" MouseUp="OnSvMouseUp">
                <Border CornerRadius="6">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#FF000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Canvas>
                        <Ellipse x:Name="SvCursor"
                                 Width="14" Height="14"
                                 Stroke="White" StrokeThickness="2" Fill="Transparent"
                                 Canvas.Left="280" Canvas.Top="10"/>
                    </Canvas>
                </Border>
            </Border>
        </Grid>

        <!-- Slider Teinte -->
        <Grid Grid.Row="1" Margin="0,6,0,0">
            <Border CornerRadius="5" Height="14">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFFF0000" Offset="0"/>
                        <GradientStop Color="#FFFFFF00" Offset="0.167"/>
                        <GradientStop Color="#FF00FF00" Offset="0.333"/>
                        <GradientStop Color="#FF00FFFF" Offset="0.5"/>
                        <GradientStop Color="#FF0000FF" Offset="0.667"/>
                        <GradientStop Color="#FFFF00FF" Offset="0.833"/>
                        <GradientStop Color="#FFFF0000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Slider x:Name="HueSlider"
                    Style="{StaticResource FlatSlider}"
                    Minimum="0" Maximum="360" Value="0"
                    Background="Transparent"
                    ValueChanged="OnHueChanged"/>
        </Grid>

        <!-- Slider Alpha -->
        <Grid Grid.Row="2" Margin="0,6,0,0">
            <Border x:Name="AlphaTrackBorder" CornerRadius="5" Height="14"/>
            <Slider x:Name="AlphaSlider"
                    Style="{StaticResource FlatSlider}"
                    Minimum="0" Maximum="255" Value="255"
                    Background="Transparent"
                    ValueChanged="OnAlphaChanged"/>
        </Grid>

        <!-- RGB + Hex + Preview -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- R -->
            <Grid Grid.Row="0" Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="R" Foreground="#FFFF6666" VerticalAlignment="Center" FontWeight="Bold"/>
                <Slider x:Name="RSlider" Grid.Column="1" Minimum="0" Maximum="255"
                        Style="{StaticResource FlatSlider}" Margin="4,0"
                        Background="#33FF0000" ValueChanged="OnRgbChanged"/>
                <TextBox x:Name="RBox" Grid.Column="2" Text="255"
                         Background="#FF2A2A3A" Foreground="White" BorderBrush="#44FFFFFF"
                         TextAlignment="Center" FontSize="11" Padding="2"
                         LostFocus="OnRgbBoxLostFocus" KeyDown="OnRgbBoxKeyDown" Tag="R"/>
            </Grid>

            <!-- G -->
            <Grid Grid.Row="1" Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="G" Foreground="#FF66FF66" VerticalAlignment="Center" FontWeight="Bold"/>
                <Slider x:Name="GSlider" Grid.Column="1" Minimum="0" Maximum="255"
                        Style="{StaticResource FlatSlider}" Margin="4,0"
                        Background="#3300FF00" ValueChanged="OnRgbChanged"/>
                <TextBox x:Name="GBox" Grid.Column="2" Text="0"
                         Background="#FF2A2A3A" Foreground="White" BorderBrush="#44FFFFFF"
                         TextAlignment="Center" FontSize="11" Padding="2"
                         LostFocus="OnRgbBoxLostFocus" KeyDown="OnRgbBoxKeyDown" Tag="G"/>
            </Grid>

            <!-- B -->
            <Grid Grid.Row="2" Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="B" Foreground="#FF6666FF" VerticalAlignment="Center" FontWeight="Bold"/>
                <Slider x:Name="BSlider" Grid.Column="1" Minimum="0" Maximum="255"
                        Style="{StaticResource FlatSlider}" Margin="4,0"
                        Background="#330000FF" ValueChanged="OnRgbChanged"/>
                <TextBox x:Name="BBox" Grid.Column="2" Text="0"
                         Background="#FF2A2A3A" Foreground="White" BorderBrush="#44FFFFFF"
                         TextAlignment="Center" FontSize="11" Padding="2"
                         LostFocus="OnRgbBoxLostFocus" KeyDown="OnRgbBoxKeyDown" Tag="B"/>
            </Grid>

            <!-- Hex + Preview -->
            <Grid Grid.Row="3" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="#" Foreground="#FFAAAACC" VerticalAlignment="Center" Margin="0,0,2,0"/>
                <TextBox x:Name="HexBox" Grid.Column="1"
                         Background="#FF2A2A3A" Foreground="White" BorderBrush="#44FFFFFF"
                         FontSize="12" Padding="4,2" FontFamily="Consolas"
                         MaxLength="6"
                         LostFocus="OnHexBoxLostFocus" KeyDown="OnHexBoxKeyDown"/>
                <TextBlock Grid.Column="2" Text="Apercu" Foreground="#FFAAAACC"
                           VerticalAlignment="Center" Margin="8,0,4,0" FontSize="10"/>
                <Border x:Name="PreviewBorder" Grid.Column="3"
                        Width="46" Height="26" CornerRadius="6"
                        BorderBrush="#44FFFFFF" BorderThickness="1"/>
            </Grid>
        </Grid>

        <!-- OK / Annuler -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="OK" Margin="0,0,6,0" Height="34"
                    Background="#FF2255AA" Foreground="White" BorderBrush="Transparent"
                    FontWeight="Bold" Cursor="Hand" Click="OnOkClick">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Grid.Column="1" Content="Annuler" Margin="6,0,0,0" Height="34"
                    Background="#FF444444" Foreground="White" BorderBrush="Transparent"
                    Cursor="Hand" Click="OnCancelClick">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</Window>