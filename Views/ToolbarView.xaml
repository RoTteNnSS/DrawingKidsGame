<UserControl x:Class="ColorKids.Views.ToolbarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ColorKids.ViewModels"
             xmlns:models="clr-namespace:ColorKids.Models"
             Background="{StaticResource ToolbarBackground}"
             Width="200">

    <DockPanel LastChildFill="False">

        <!-- â•â• Couleur active â•â• -->
        <Border x:Name="ActiveColorBorder"
                DockPanel.Dock="Top"
                Width="64" Height="64" CornerRadius="32"
                Margin="4,10,4,6"
                BorderBrush="White" BorderThickness="3"
                HorizontalAlignment="Center"/>

        <!-- â•â• Palette 2Ã—6 â•â• -->
        <UniformGrid x:Name="PaletteGrid" DockPanel.Dock="Top"
                     Columns="6" Rows="2" Margin="6,2,6,6"/>

        <Button x:Name="ColorPickerBtn"
                DockPanel.Dock="Top"
                HorizontalAlignment="Stretch" Height="28"
                Margin="6,2,6,6"
                Cursor="Hand" Click="OnColorPickerClick"
                Background="#FF2A2A3A" BorderBrush="#44FFFFFF" BorderThickness="1">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="+ " Foreground="White" FontSize="13" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <TextBlock Text="Couleur personnalisee" Foreground="#FFAAAACC" FontSize="10"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <Separator DockPanel.Dock="Top" Background="#44FFFFFF" Margin="8,4"/>

        <!-- â•â• Taille du pinceau â•â• -->
        <TextBlock DockPanel.Dock="Top" Text="Taille" Foreground="#FFAAAACC"
                   FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,1"/>
        <Slider x:Name="BrushSlider"
                DockPanel.Dock="Top"
                Minimum="10" Maximum="80" Value="30"
                Orientation="Horizontal"
                Margin="10,2,10,6"
                TickFrequency="10" SmallChange="5" LargeChange="10"
                Foreground="White"
                ValueChanged="OnBrushSizeChanged"/>

        <Separator DockPanel.Dock="Top" Background="#44FFFFFF" Margin="8,4"/>

        <!-- â•â• GROUPE : Outils de dessin â•â• -->
        <TextBlock DockPanel.Dock="Top" Text="OUTILS" Foreground="#FFAAAACC"
                   FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,4"/>
        <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="4,0,4,4">
            <ToggleButton x:Name="BrushBtn"
                          Style="{StaticResource ToolButtonStyle}"
                          ToolTip="Pinceau"
                          Height="56"
                          Click="OnToolButtonClick" Tag="Brush">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="M4,20 Q2,18 4,16 L16,4 Q18,2 20,4 L22,6 Q24,8 22,10 L10,22 Q8,24 6,22 Z"
                          Fill="White" Stretch="Uniform" Width="28" Height="28"/>
                    <TextBlock Text="Pinceau" Foreground="White" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="EraserBtn"
                          Style="{StaticResource ToolButtonStyle}"
                          ToolTip="Gomme"
                          Height="56"
                          Click="OnToolButtonClick" Tag="Eraser">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="M3,17 L9,5 Q11,2 14,4 L21,11 Q23,14 20,16 L14,19 Z M3,17 L14,17"
                          Stroke="White" StrokeThickness="2" Fill="Transparent"
                          Stretch="Uniform" Width="28" Height="28"/>
                    <TextBlock Text="Gomme" Foreground="White" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="FillBtn"
                          Style="{StaticResource ToolButtonStyle}"
                          ToolTip="Remplissage"
                          Height="56"
                          Click="OnToolButtonClick" Tag="Fill">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Width="28" Height="28">
                        <Path Data="M6,20 Q3,20 3,17 L3,12 L14,12 L14,17 Q14,20 11,20 Z" Fill="White"/>
                        <Path Data="M8,12 L8,3 M6,3 L10,3" Stroke="White" StrokeThickness="2"/>
                        <Ellipse Canvas.Left="18" Canvas.Top="16" Width="8" Height="8" Fill="#FF4CAF50"/>
                    </Canvas>
                    <TextBlock Text="Remplir" Foreground="White" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
            </ToggleButton>
        </UniformGrid>

        <Separator DockPanel.Dock="Top" Background="#44FFFFFF" Margin="8,4"/>

        <!-- â•â• GROUPE : Actions â•â• -->
        <TextBlock DockPanel.Dock="Top" Text="ACTIONS" Foreground="#FFAAAACC"
                   FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,4"/>
        <UniformGrid DockPanel.Dock="Top" Columns="2" Margin="4,0,4,4">
            <Button x:Name="UndoBtn"
                    Style="{StaticResource ActionButtonStyle}"
                    Height="56" Margin="3"
                    Click="OnUndoClick"
                    IsEnabled="False"
                    Background="#FF444444">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="M12,8 A6,6,0,1,0,18,14 M12,8 L9,5 M12,8 L15,5"
                          Stroke="White" StrokeThickness="2" Fill="Transparent"
                          Stretch="Uniform" Width="28" Height="28"/>
                    <TextBlock Text="Annuler" Foreground="White" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
            </Button>
            <Button x:Name="ClearBtn"
                    Style="{StaticResource ActionButtonStyle}"
                    Height="56" Margin="3"
                    Click="OnClearClick"
                    Background="#FF664444">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="M6,6 L18,18 M18,6 L6,18"
                          Stroke="White" StrokeThickness="3"
                          Stretch="Uniform" Width="28" Height="28"/>
                    <TextBlock Text="Effacer" Foreground="White" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
            </Button>
        </UniformGrid>

        <Separator DockPanel.Dock="Top" Background="#44FFFFFF" Margin="8,4"/>

        <!-- â•â• GROUPE : Fichiers / Dessins â•â• -->
        <TextBlock DockPanel.Dock="Top" Text="DESSIN" Foreground="#FFAAAACC"
                   FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,4"/>
        <UniformGrid DockPanel.Dock="Top" Columns="2" Margin="4,0,4,4">
            <Button x:Name="TemplateBtn"
                    Style="{StaticResource ActionButtonStyle}"
                    Height="56" Margin="3"
                    Click="OnTemplateClick" ToolTip="Choisir un dessin"
                    Background="#FF2255AA">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="M12,2 L14.5,9 L22,9 L16,13.5 L18.5,21 L12,16.5 L5.5,21 L8,13.5 L2,9 L9.5,9 Z"
                          Fill="White" Stretch="Uniform" Width="28" Height="28"/>
                    <TextBlock Text="Dessins" Foreground="White" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
            </Button>
            <Button x:Name="ImportBtn"
                    Style="{StaticResource ActionButtonStyle}"
                    Height="56" Margin="3"
                    Click="OnImportClick" ToolTip="Importer une image"
                    Background="#FF225522">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="M3,7 Q3,5 5,5 L9,5 L11,7 L19,7 Q21,7 21,9 L21,17 Q21,19 19,19 L5,19 Q3,19 3,17 Z"
                          Fill="White" Stretch="Uniform" Width="28" Height="28"/>
                    <TextBlock Text="Importer" Foreground="White" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
            </Button>
        </UniformGrid>

        <!-- Indicateur de traitement -->
        <Border x:Name="ProcessingIndicator" DockPanel.Dock="Top"
                Background="#BB000000" CornerRadius="6"
                Padding="4,3" Margin="6,2" Visibility="Collapsed">
            <TextBlock Text="Traitement..." Foreground="White" FontSize="10"
                       HorizontalAlignment="Center"/>
        </Border>

        <Separator DockPanel.Dock="Top" Background="#44FFFFFF" Margin="8,4"/>

        <!-- â•â• GROUPE : Zoom â•â• -->
        <TextBlock DockPanel.Dock="Top" Text="ZOOM" Foreground="#FFAAAACC"
                   FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,4"/>
        <Grid DockPanel.Dock="Top" Margin="4,0,4,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="ZoomOutBtn"
                    Style="{StaticResource ActionButtonStyle}"
                    Grid.Column="0" Height="40" Margin="2,0"
                    Click="OnZoomOutClick" ToolTip="Zoom arri&#232;re"
                    Background="#FF2A2A3A">
                <TextBlock Text="-" Foreground="White" FontSize="22" FontWeight="Bold"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Button>
            <Button x:Name="ZoomResetBtn"
                    Style="{StaticResource ActionButtonStyle}"
                    Grid.Column="1" Height="40" Margin="1,0"
                    Click="OnZoomResetClick" ToolTip="Zoom 100%"
                    Background="#FF2A2A3A">
                <TextBlock x:Name="ZoomLabel" Text="100%" Foreground="#FFAAAACC" FontSize="11"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Button>
            <Button x:Name="ZoomInBtn"
                    Style="{StaticResource ActionButtonStyle}"
                    Grid.Column="2" Height="40" Margin="2,0"
                    Click="OnZoomInClick" ToolTip="Zoom avant"
                    Background="#FF2A2A3A">
                <TextBlock Text="+" Foreground="White" FontSize="22" FontWeight="Bold"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Button>
        </Grid>

    </DockPanel>
</UserControl>