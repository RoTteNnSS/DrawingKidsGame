<Window x:Class="ColorKids.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:ColorKids.Views"
        mc:Ignorable="d"
        Title="ColorKids" Height="768" Width="1100"
        WindowState="Maximized"
        Background="Black">

    <DockPanel>

        <!-- ===== Barre de menu ===== -->
        <Menu DockPanel.Dock="Top" Background="#FF2A2A3A" Foreground="White"
              FontSize="13" Padding="4,2">
            <Menu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="#FF2A2A3A"/>
                </Style>
            </Menu.Resources>

            <!-- Fichier -->
            <MenuItem Header="_Fichier">
                <MenuItem x:Name="MenuSavePng"  Header="Enregistrer en _PNG..."
                          Click="OnSavePng"
                          InputGestureText="Ctrl+S"/>
                <MenuItem x:Name="MenuSaveJpeg" Header="Enregistrer en _JPEG..."
                          Click="OnSaveJpeg"/>
                <MenuItem x:Name="MenuSaveBmp"  Header="Enregistrer en _BMP..."
                          Click="OnSaveBmp"/>
                <MenuItem x:Name="MenuSaveSvg"  Header="Enregistrer en _SVG..."
                          Click="OnSaveSvg"/>
                <Separator/>
                <MenuItem x:Name="MenuPrint"    Header="_Imprimer..."
                          Click="OnPrint"
                          InputGestureText="Ctrl+P"/>
                <Separator/>
                <MenuItem x:Name="MenuExit"     Header="_Quitter"
                          Click="OnExit"/>
            </MenuItem>

            <!-- Affichage -->
            <MenuItem Header="_Affichage">
                <MenuItem x:Name="MenuFullscreen" Header="Plein écran (_F12)"
                          Click="OnToggleFullscreen"
                          InputGestureText="F12"/>
            </MenuItem>
        </Menu>

        <!-- ===== Zone principale ===== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Toolbar (left panel) -->
            <views:ToolbarView x:Name="Toolbar" Grid.Column="0"/>

            <!-- Canvas (main area) -->
            <views:CanvasView x:Name="DrawingCanvas" Grid.Column="1"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"/>
        </Grid>

    </DockPanel>
</Window>